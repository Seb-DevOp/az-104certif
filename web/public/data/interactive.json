{
  "_readme": "Hand-authored playable versions of DRAG DROP questions whose answer key exists in the PDF only as a screenshot. Transcribed from the exhibit and answer images of the matching question id. Adding an entry here turns that question from 'reveal and self-grade' into a machine-graded drag-and-drop; the original screenshots stay available as the answer key. French labels live in fr.json under the same id.",

  "3": {
    "kind": "dragdrop",
    "prompt": "Drag every object that must be created onto the answer area. Distractors stay in the list.",
    "items": [
      { "id": "hyperv-site", "label": "Hyper-V site" },
      { "id": "storage-account", "label": "Storage account" },
      { "id": "recovery-vault", "label": "Azure Recovery Services Vault" },
      { "id": "traffic-manager", "label": "Azure Traffic Manager instance" },
      { "id": "replication-policy", "label": "Replication policy" },
      { "id": "endpoint", "label": "Endpoint" }
    ],
    "targets": [
      {
        "id": "answer",
        "label": "Answer area",
        "accepts": ["hyperv-site", "recovery-vault", "replication-policy"]
      }
    ]
  },

  "68": {
